# Google Cloud OAuth 2.0 Client ID (type: Web application).
# Authorized JavaScript origins must include http://localhost:5173 and your Vercel domain.
VITE_GOOGLE_CLIENT_ID=

# Google Cloud API key, restricted to the Google Picker API. Optional:
# only the "Add from Drive" path needs it. Upload works without it.
VITE_GOOGLE_API_KEY=
